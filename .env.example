# Copy to .env (gitignored). Compose reads it at run time; nothing here reaches the image.
# Optional: with a credential the agent runs `claude -p`; without one it only probes api.anthropic.com.
# Set ONE of these, never both (the agent refuses to start if both are set):
#   CLAUDE_CODE_OAUTH_TOKEN  for a Claude subscription; get it with `claude setup-token`. Preferred.
#   ANTHROPIC_API_KEY        otherwise, an API key from the Console.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# Not secret. .build.ps1 reads these from .env, else the environment, else these defaults, and hands both to
# every docker compose call (design 9). The port is reserved for an Alerts/Ledger API; nothing publishes it yet.
CLAUDE_AGENT_PORT=8300
COMPOSE_PROJECT_NAME=claude-agent-dev
